{
  "info": {
    "name": "NirmanIQ Day 12 — Validation & Filters",
    "description": "Full Day 12 test suite. Start the server (`npm run start:dev`), then Run collection. Best with a fresh server restart so the in-memory projects array is at seed state.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "1. Projects Validation",
      "item": [
        {
          "name": "1.1 Empty body → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('Response has message array', () => pm.expect(body.message).to.be.an('array'));",
                  "pm.test('Message array has 3+ entries', () => pm.expect(body.message.length).to.be.gte(3));",
                  "pm.test('Has consistent filter shape', () => {",
                  "  pm.expect(body).to.have.property('statusCode', 400);",
                  "  pm.expect(body).to.have.property('error');",
                  "  pm.expect(body).to.have.property('timestamp');",
                  "  pm.expect(body).to.have.property('path', '/projects');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/projects",
            "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "1.2 name too short → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Name minLength error present', () => {",
                  "  const msgs = pm.response.json().message;",
                  "  pm.expect(msgs.some(m => m.includes('longer than or equal to 3'))).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/projects",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"AB\",\n  \"status\": \"ACTIVE\",\n  \"towerCount\": 5\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "1.3 invalid status enum → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Enum error present', () => {",
                  "  const msgs = pm.response.json().message;",
                  "  pm.expect(msgs.some(m => m.includes('PLANNING, ACTIVE, COMPLETED, ON_HOLD'))).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/projects",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Valid\",\n  \"status\": \"WRONG\",\n  \"towerCount\": 5\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "1.4 towerCount > 50 → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Max error present', () => {",
                  "  const msgs = pm.response.json().message;",
                  "  pm.expect(msgs.some(m => m.includes('greater than 50'))).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/projects",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Valid\",\n  \"status\": \"ACTIVE\",\n  \"towerCount\": 100\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "1.5 extra field → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Rejects unknown field', () => {",
                  "  const msgs = pm.response.json().message;",
                  "  pm.expect(msgs.some(m => m.includes('hacked should not exist'))).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/projects",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Valid\",\n  \"status\": \"ACTIVE\",\n  \"towerCount\": 5,\n  \"hacked\": true\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "1.6 description > 500 chars → 400",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.variables.set('longDesc', 'a'.repeat(501));"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('MaxLength error mentions 500', () => {",
                  "  const msgs = pm.response.json().message;",
                  "  pm.expect(msgs.some(m => m.includes('500'))).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/projects",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Valid\",\n  \"status\": \"ACTIVE\",\n  \"towerCount\": 5,\n  \"description\": \"{{longDesc}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "1.7 GET /projects/999 → 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "const body = pm.response.json();",
                  "pm.test('Message mentions id', () => pm.expect(body.message).to.include('999'));",
                  "pm.test('Filter shape intact', () => {",
                  "  pm.expect(body).to.have.property('statusCode', 404);",
                  "  pm.expect(body).to.have.property('timestamp');",
                  "  pm.expect(body).to.have.property('path', '/projects/999');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/projects/999"
          }
        },
        {
          "name": "1.8 valid POST → 201 (sanity)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Returns created object', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('id');",
                  "  pm.expect(body.name).to.eql('Valid Project');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/projects",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Valid Project\",\n  \"status\": \"ACTIVE\",\n  \"towerCount\": 5\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "2. Error Filter Shape",
      "item": [
        {
          "name": "2.1 No stack trace leak",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('No stack trace leaked', () => {",
                  "  const body = pm.response.text();",
                  "  pm.expect(body).to.not.include('at Object.');",
                  "  pm.expect(body).to.not.include('.ts:');",
                  "});",
                  "pm.test('Has all 5 filter keys', () => {",
                  "  const b = pm.response.json();",
                  "  ['statusCode','message','error','timestamp','path'].forEach(k =>",
                  "    pm.expect(b).to.have.property(k));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/projects/999"
          }
        }
      ]
    },
    {
      "name": "3. Nested Towers",
      "item": [
        {
          "name": "3.1 valid tower with floorList → 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Echoes floorList array of 2', () => {",
                  "  pm.expect(body.floorList).to.be.an('array').with.lengthOf(2);",
                  "  pm.expect(body.floorList[0].name).to.eql('Ground');",
                  "});",
                  "pm.test('Has projectId from URL', () => pm.expect(body.projectId).to.eql('1'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/projects/1/towers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tower C\",\n  \"floors\": 25,\n  \"status\": \"Planned\",\n  \"floorList\": [\n    { \"name\": \"Ground\", \"number\": 1 },\n    { \"name\": \"First\", \"number\": 2 }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "3.2 missing floorList → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('floorList array error', () => {",
                  "  const msgs = pm.response.json().message;",
                  "  pm.expect(msgs.some(m => m.includes('floorList must be an array'))).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/projects/1/towers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tower D\",\n  \"floors\": 10,\n  \"status\": \"Planned\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "3.3 nested floor number > 200 → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Nested error uses dot path floorList.0.number', () => {",
                  "  const msgs = pm.response.json().message;",
                  "  pm.expect(msgs.some(m => m.includes('floorList.0.number'))).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/projects/1/towers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tower E\",\n  \"floors\": 10,\n  \"status\": \"Planned\",\n  \"floorList\": [{ \"name\": \"A\", \"number\": 999 }]\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "3.4 nested floor name < 2 chars → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Nested name error uses dot path floorList.0.name', () => {",
                  "  const msgs = pm.response.json().message;",
                  "  pm.expect(msgs.some(m => m.includes('floorList.0.name'))).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/projects/1/towers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tower F\",\n  \"floors\": 10,\n  \"status\": \"Planned\",\n  \"floorList\": [{ \"name\": \"X\", \"number\": 1 }]\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    }
  ]
}